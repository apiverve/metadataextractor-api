{
    "name": "apiverve/metadataextractor",
    "description": "Metadata Extractor is a website metadata extraction API that pulls HTML meta tags from any submitted URL, returning the page title, meta description, author, robots directives, and language. Paid tiers add Open Graph tags, JSON-LD schemas, and favicons.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "metadataextractor",
        "website metadata extraction api",
        "metadata extractor api",
        "url metadata extractor",
        "meta tag extractor",
        "metadata api"
    ],
    "homepage": "https://apiverve.com/marketplace/metadataextractor?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/metadataextractor",
        "source": "https://github.com/apiverve/metadataextractor-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Metadataextractor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Metadataextractor\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
